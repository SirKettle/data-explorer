{
  "name": "data-xplorer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p site/src/demos",
    "test": "bun test site/src/demos",
    "check:docs": "bun run scripts/check-docs.ts",
    "check": "bun run --cwd packages/core check && bun run --cwd apps/world check && bun run typecheck && bun run test && bun run check:docs"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
