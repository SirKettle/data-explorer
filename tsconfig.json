{
  // Shared by every workspace (packages/*, apps/*) and the docs site's demos, which extend it.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["bun-types"],
    // The packages by their published names, resolved to their source: an app or a demo always
    // runs the code in this commit, with no build in between.
    "paths": {
      "@data-xplorer/core": ["./packages/core/src/index.ts"],
      "@data-xplorer/core/headless": ["./packages/core/src/headless.ts"],
      "@data-xplorer/core/pixi": ["./packages/core/src/pixi.ts"]
    }
  },
  "include": ["scripts"]
}
