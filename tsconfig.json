{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["bun-types"],
    // The package imports itself by its published name in scripts/consumer; resolve that to source.
    "paths": {
      "@thirkettle/data-explorer": ["./src/index.ts"],
      "@thirkettle/data-explorer/headless": ["./src/headless.ts"],
      "@thirkettle/data-explorer/pixi": ["./src/pixi.ts"]
    }
  },
  "include": ["src", "test", "scripts"]
}
