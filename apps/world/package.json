{
  "name": "@data-xplorer/world",
  "private": true,
  "description": "The world as fixed scenes of real country shapes: continents, each entered to its countries.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run server.ts",
    "build": "bun build ./src/index.html --outdir dist --minify --splitting",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run build",
    "ladle": "ladle serve"
  },
  "dependencies": {
    "@data-xplorer/core": "workspace:*",
    "d3-geo": "^3.1.1",
    "pixi.js": "^8.13.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@ladle/react": "5.1.1",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "bun-types": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
